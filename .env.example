# Copy to .env and replace every placeholder; never commit .env.
AWS_PROFILE=default
AWS_REGION=us-east-1
TF_STATE_BUCKET=rag-dev-tf-state-bucket-ACCOUNT_ID
TF_STATE_KMS_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT_ID:key/KEY_ID
RUNTIME_PRINCIPAL_ARN=arn:aws:iam::ACCOUNT_ID:role/LOCAL_OPERATOR_ROLE
REPOSITORY_SUBJECT=repo:OWNER/REPO:ref:refs/heads/BRANCH
RAG_RUNTIME_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/dev-rag
