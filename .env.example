# Copy to .env and replace every placeholder; never commit .env.
# The local AWS profile starts STS AssumeRole; both services use the resulting role.
AWS_PROFILE=default
AWS_REGION=us-east-1
# Terragrunt's remote state backend needs the bucket name and KMS key ARN.
TF_STATE_BUCKET=rag-dev-tf-state-bucket-ACCOUNT_ID
TF_STATE_KMS_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT_ID:key/KEY_ID
# The foundation trusts only this principal to assume the runtime role.
RUNTIME_PRINCIPAL_ARN=arn:aws:iam::ACCOUNT_ID:role/LOCAL_OPERATOR_ROLE
# Match the exact GitHub OIDC subject authorized to access foundation state.
REPOSITORY_SUBJECT=repo:OWNER/REPO:ref:refs/heads/BRANCH
# Set this to the role ARN output by the reviewed foundation apply.
RAG_RUNTIME_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/dev-rag
